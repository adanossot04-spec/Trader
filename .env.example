# ─── Скопіюйте у .env. Усе нижче — БЕЗКОШТОВНІ тарифи або взагалі без ключа ────
# Мінімум для роботи: НІЧОГО. Добові свічки беруться з Yahoo без ключа,
# а коментар до пропозиції складає код (llm.provider: none).

# ═══ 1. LLM-коментар (необов'язково; виберіть провайдера в config.yaml → llm.provider) ═══
# Groq — безкоштовний тариф, дуже швидко: https://console.groq.com/keys
GROQ_API_KEY=
# Google Gemini — безкоштовний тариф AI Studio: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# OpenRouter — безкоштовні моделі з суфіксом :free: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# (опційно) локальні моделі Ollama — ключ не потрібен: ollama pull llama3.1
# (опційно) платні провайдери, якщо колись захочете:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ═══ 2. Альтернативні джерела добових свічок (необов'язково) ═══
# Yahoo працює без ключа й стоїть першим у config.yaml → data.sources.
# Якщо Yahoo почне відмовляти — додайте безкоштовні ключі нижче:
# Twelve Data — 800 запитів/добу безкоштовно: https://twelvedata.com/pricing
TWELVEDATA_API_KEY=
# Alpha Vantage — 25 запитів/добу безкоштовно: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# ═══ 3. Макро-дані для глибокого аналізу (необов'язково, для TradingAgents) ═══
# FRED — безкоштовний ключ: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# SEC просить контакт того, хто робить запити
SEC_EDGAR_USER_AGENT="Your Name you@example.com"

# ═══ 4. Telegram (необов'язково) ═══
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ═══ 4б. Пошта через Resend (необов'язково; безкоштовно до 100 листів/добу) ═══
# Ключ: https://resend.com/api-keys  →  resend.com → API Keys → Create
# Надсилається одне структуроване зведення на прогін (режим ринку, схвалені угоди
# з фундаменталом і звітністю, заблоковані тікери, готові заявки).
RESEND_API_KEY=
MAIL_TO=                      # кому: me@example.com (кілька адрес — через кому)
MAIL_FROM=                    # від кого: "Помічник <onboarding@resend.dev>" поки домен не підтверджено
RESULTS_URL=                  # необов'язково: посилання на сторінку результатів у листі

# ═══ 5. Розклад (задається в config.yaml → schedule) ═══
# Головне вікно: 8:30 за Нью-Йорком (пн–пт) = за 60 хв до відкриття US-ринку.
# Таймзону НЕ переводимо в київську: у перехідні тижні (березень, кінець жовтня)
# це дало б зсув на годину й прогін потрапив би рівно на відкриття.

# ═══ 6. Сервіс ═══
ASSISTANT_HOST=0.0.0.0
ASSISTANT_PORT=8000
ASSISTANT_DATA_DIR=data
# Швидкі перемикачі (перекривають config.yaml):
# ASSISTANT_LLM_PROVIDER=groq
# ASSISTANT_LLM_MODEL=llama-3.3-70b-versatile
# ASSISTANT_ENGINE_MODE=mock
